{
  "name": "penta",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter web dev --port 43121",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start --port 43121",
    "lint": "pnpm --filter web lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "report": "tsx scripts/launch-report.ts",
    "qa": "vitest run && tsx scripts/seo-audit.ts",
    "deep-qa": "tsx scripts/deep-graph-qa.ts",
    "graph:audit": "tsx scripts/graph-audit.ts",
    "graph:health": "tsx scripts/graph-health.ts",
    "graph:inspect": "tsx scripts/graph-inspect.ts",
    "truth-gate": "tsx scripts/truth-gate.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
